{
    "resource": "admin.admin_users",
    "table_name": "admins",
    "migration_owner": "domain",
    "schema": {
        "name": "admin_users",
        "title": "管理员",
        "description": "管理后台登录账号、角色和直接授权。",
        "features": {
            "layout": "single"
        },
        "capabilities": {
            "allow_recycle": true
        },
        "views": {
            "searches": {
                "default": {
                    "fields": ["account_keyword", "email", "mobile", "status"]
                }
            },
            "tables": {
                "default": {
                    "columns": [
                        { "field": "username" },
                        { "field": "nickname" },
                        { "field": "email" },
                        { "field": "mobile" },
                        { "field": "status" },
                        { "field": "is_founder" },
                        { "field": "login_at", "minWidth": 200 },
                        { "field": "login_ip" }
                    ],
                    "operate": {
                        "minWidth": 320,
                        "actions": [
                            { "action": "update" },
                            {
                                "action": "sync_roles",
                                "title": "设置角色",
                                "icon": "users",
                                "show_when": { "field": "is_founder", "op": "neq", "value": true }
                            },
                            { "action": "reset_password", "title": "重置密码", "icon": "key-round" },
                            {
                                "action": "delete",
                                "show_when": {
                                    "field": "is_founder",
                                    "op": "neq",
                                    "value": true
                                }
                            }
                        ]
                    }
                }
            },
            "forms": {
                "sync_roles": {
                    "title": "",
                    "span": 24,
                    "props": { "labelPosition": "top" },
                    "children": [{ "type": "field", "field": "role_ids" }]
                },
                "reset_password": {
                    "title": "",
                    "span": 24,
                    "props": { "labelPosition": "top" },
                    "children": [{
                        "type": "field",
                        "field": "password",
                        "title": "新密码",
                        "component": "password",
                        "help": "6–36 个字符。",
                        "props": { "autocomplete": "new-password", "showPassword": true }
                    }, {
                        "type": "field",
                        "field": "password_confirmation",
                        "component": "password",
                        "props": { "autocomplete": "new-password", "showPassword": true }
                    }]
                },
                "default": {
                    "span": 12,
                    "gap": 18,
                    "props": {
                        "labelPosition": "top"
                    },
                    "children": [
                        {
                            "type": "section",
                            "span": 24,
                            "children": [
                                {
                                    "type": "field",
                                    "field": "username",
                                    "help": "4–36 个字符，支持字母、数字、点、下划线和短横线。",
                                    "readonly_when": {
                                        "field": "formMode",
                                        "op": "eq",
                                        "value": "edit"
                                    }
                                },
                                {
                                    "type": "field",
                                    "field": "nickname"
                                },
                                {
                                    "type": "field",
                                    "field": "password",
                                    "component": "password",
                                    "help": "6–36 个字符。",
                                    "props": {
                                        "autocomplete": "new-password"
                                    }
                                },
                                {
                                    "type": "field",
                                    "field": "email"
                                },
                                {
                                    "type": "field",
                                    "field": "mobile"
                                },
                                {
                                    "type": "field",
                                    "field": "avatar",
                                    "component": "image-upload",
                                    "span": 24,
                                    "props": {
                                        "accept": "image/*",
                                        "groupCode": "default",
                                        "limit": 1,
                                        "pickText": "从素材库选择",
                                        "uploadText": "上传头像",
                                        "valueMode": "url"
                                    }
                                },
                                {
                                    "type": "field",
                                    "field": "status"
                                }
                            ]
                        }
                    ]
                }
            }
        },
        "fields": [
            {
                "name": "account_keyword",
                "type": "string",
                "label": "用户名或昵称",
                "persisted": false,
                "readonly": true,
                "formable": false,
                "listable": false,
                "searchable": true,
                "extensions": {
                    "search": {
                        "fields": ["username", "nickname"]
                    }
                }
            },
            {
                "name": "username",
                "type": "string",
                "label": "用户名",
                "persisted": true,
                "required": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true,
                "normalize": {
                    "trim": true
                },
                "validation": [
                    {
                        "type": "pattern",
                        "value": "^[A-Za-z0-9_.-]{4,36}$",
                        "message": "用户名只能包含字母、数字、点、下划线和短横线，长度为 4 到 36 个字符"
                    }
                ]
            },
            {
                "name": "nickname",
                "type": "string",
                "label": "昵称",
                "persisted": true,
                "required": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true,
                "normalize": [],
                "validation": [
                    {
                        "type": "max_length",
                        "value": 100,
                        "message": "昵称不能超过 100 个字符"
                    }
                ]
            },
            {
                "name": "email",
                "type": "string",
                "label": "电子邮箱",
                "persisted": true,
                "required": false,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true,
                "normalize": {
                    "empty_as_null": true
                },
                "validation": [
                    {
                        "type": "format",
                        "value": "email",
                        "message": "电子邮箱格式不正确"
                    },
                    {
                        "type": "max_length",
                        "value": 255,
                        "message": "电子邮箱不能超过 255 个字符"
                    }
                ]
            },
            {
                "name": "mobile",
                "type": "string",
                "label": "手机号码",
                "persisted": true,
                "required": false,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": false,
                "normalize": {
                    "empty_as_null": true
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 30,
                        "message": "手机号码不能超过 30 个字符"
                    }
                ]
            },
            {
                "name": "avatar",
                "type": "string",
                "label": "头像地址",
                "persisted": true,
                "required": false,
                "formable": true,
                "listable": false,
                "searchable": false,
                "sortable": false,
                "normalize": {
                    "empty_as_null": true
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 255,
                        "message": "头像地址不能超过 255 个字符"
                    }
                ]
            },
            {
                "name": "status",
                "type": "boolean",
                "label": "账号状态",
                "persisted": true,
                "default": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true
            },
            {
                "name": "is_founder",
                "type": "boolean",
                "label": "创始人",
                "persisted": true,
                "readonly": true,
                "formable": false,
                "listable": true,
                "searchable": false,
                "sortable": true
            },
            {
                "name": "login_at",
                "type": "datetime",
                "label": "最近登录时间",
                "persisted": true,
                "readonly": true,
                "formable": false,
                "listable": true,
                "searchable": false,
                "sortable": true
            },
            {
                "name": "login_ip",
                "type": "string",
                "label": "最近登录 IP",
                "persisted": true,
                "readonly": true,
                "formable": false,
                "listable": true,
                "searchable": false
            },
            {
                "name": "password",
                "type": "string",
                "label": "密码",
                "persisted": false,
                "required": false,
                "formable": true,
                "listable": false,
                "extensions": {
                    "secret": {
                        "readable": false
                    }
                },
                "validation": [
                    {
                        "type": "required",
                        "when": {
                            "field": "action",
                            "op": "eq",
                            "value": "create"
                        },
                        "message": "管理员密码不能为空。"
                    },
                    {
                        "type": "complexity",
                        "params": {
                            "min_length": 6,
                            "max_length": 36
                        },
                        "message": "密码长度必须为 6 到 36 个字符"
                    }
                ]
            },
            {
                "name": "password_confirmation",
                "type": "string",
                "label": "确认新密码",
                "persisted": false,
                "formable": false,
                "listable": false,
                "extensions": { "secret": { "readable": false } }
            },
            {
                "name": "role_ids",
                "type": "integer",
                "label": "角色",
                "persisted": false,
                "multiple": true,
                "formable": false,
                "listable": false,
                "reference": {
                    "resource": "admin.admin_roles",
                    "value_field": "id",
                    "label_field": "name"
                }
            },
            {
                "name": "permissions",
                "type": "json",
                "label": "直接授权",
                "persisted": false,
                "readonly": true,
                "formable": false,
                "listable": false
            }
        ],
        "actions": {
            "sync_roles": {
                "title": "设置角色",
                "kind": "custom",
                "scope": "record",
                "show_when": { "field": "is_founder", "op": "neq", "value": true }
            },
            "sync_permissions": {
                "label": "设置直接授权"
            },
            "reset_password": {
                "title": "重置密码",
                "kind": "custom",
                "scope": "record"
            },
            "revoke_sessions": {
                "label": "撤销会话"
            }
        }
    }
}
