{
    "resource": "admin.admin_resources",
    "table_name": "admin_menus",
    "migration_owner": "domain",
    "schema": {
        "name": "admin_resources",
        "title": "后台导航",
        "description": "管理独立导航层级与页面入口，业务权限由显式声明维护。",
        "features": {
            "layout": "single"
        },
        "capabilities": {
            "soft_delete": true
        },
        "tree": {
            "enabled": true,
            "key_field": "resource_key",
            "parent_field": "parent_key",
            "order_field": "sort"
        },
        "views": {
            "searches": false,
            "page": {
                "table": "default",
                "createForm": "default",
                "updateForm": "default"
            },
            "tables": {
                "default": {
                    "mode": "tree",
                    "tree": {
                        "default_expand": "all",
                        "expand_column": "title"
                    },
                    "fields": [
                        "title",
                        "resource_key",
                        "type",
                        "owner_type",
                        "owner_code",
                        "path",
                        "status"
                    ],
                    "pagination": false,
                    "toolbar": {
                        "left": [
                            {
                                "action": "create",
                                "title": "新增导航"
                            }
                        ],
                        "right": [
                            {
                                "action": "reload",
                                "title": "刷新"
                            }
                        ],
                        "batch": []
                    },
                    "selection": false,
                    "operate": [
                        {
                            "action": "update",
                            "title": "编辑"
                        },
                        {
                            "action": "delete",
                            "title": "删除",
                            "show_when": {
                                "field": "owner_type",
                                "op": "eq",
                                "value": "custom"
                            }
                        }
                    ]
                }
            },
            "forms": {
                "default": {
                    "title": "导航编辑",
                    "wrapper": {
                        "type": "dialog",
                        "props": {
                            "width": "760px"
                        }
                    },
                    "span": 12,
                    "gap": 18,
                    "props": {
                        "labelPosition": "top"
                    },
                    "children": [
                        {
                            "type": "field",
                            "field": "resource_key",
                            "span": 12
                        },
                        {
                            "type": "field",
                            "field": "title",
                            "span": 12
                        },
                        {
                            "type": "field",
                            "field": "type",
                            "span": 12,
                            "component": "admin-menu-type-picker"
                        },
                        {
                            "type": "field",
                            "field": "parent_key",
                            "span": 12,
                            "props": {
                                "checkStrictly": true
                            }
                        },
                        {
                            "type": "group",
                            "span": 24,
                            "children": [
                                {
                                    "type": "field",
                                    "field": "path",
                                    "span": 12,
                                    "show_when": {
                                        "field": "type",
                                        "op": "neq",
                                        "value": "group"
                                    }
                                },
                                {
                                    "type": "field",
                                    "field": "target_resource_key",
                                    "span": 12,
                                    "component": "admin-schema-resource-picker",
                                    "show_when": {
                                        "field": "type",
                                        "op": "eq",
                                        "value": "schema"
                                    }
                                },
                                {
                                    "type": "field",
                                    "field": "external_url",
                                    "span": 12,
                                    "show_when": {
                                        "field": "type",
                                        "op": "eq",
                                        "value": "external"
                                    }
                                },
                                {
                                    "type": "field",
                                    "field": "icon",
                                    "span": 12,
                                    "component": "icon-input",
                                    "props": {
                                        "icons": [
                                            "bell",
                                            "blocks",
                                            "book-open-text",
                                            "building-2",
                                            "cloud",
                                            "external-link",
                                            "file-text",
                                            "folder",
                                            "images",
                                            "key-round",
                                            "layout-dashboard",
                                            "list-checks",
                                            "list-tree",
                                            "menu",
                                            "network",
                                            "palette",
                                            "scroll-text",
                                            "settings",
                                            "shield-check",
                                            "users"
                                        ]
                                    }
                                }
                            ]
                        },
                        {
                            "type": "group",
                            "span": 24,
                            "show_when": {
                                "field": "type",
                                "op": "neq",
                                "value": "group"
                            },
                            "children": [
                                {
                                    "type": "field",
                                    "field": "visibility",
                                    "span": 12
                                },
                                {
                                    "type": "field",
                                    "field": "entry_permission",
                                    "component": "admin-entry-permission-picker",
                                    "span": 12,
                                    "show_when": {
                                        "field": "visibility",
                                        "op": "eq",
                                        "value": "permission"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "field",
                            "field": "is_menu",
                            "span": 12
                        },
                        {
                            "type": "field",
                            "field": "status",
                            "span": 12
                        },
                        {
                            "type": "field",
                            "field": "sort",
                            "span": 12
                        }
                    ]
                }
            }
        },
        "actions": {
            "move_resource": {
                "label": "移动导航"
            },
            "move_menu": {
                "label": "移动导航"
            }
        },
        "fields": [
            {
                "name": "resource_key",
                "type": "string",
                "label": "导航编码",
                "persisted": true,
                "required": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true,
                "normalize": {
                    "trim": true,
                    "case": "lower"
                },
                "validation": [
                    {
                        "type": "pattern",
                        "value": "^[a-z][a-z0-9._-]{1,190}$",
                        "message": "导航编码格式不正确"
                    }
                ]
            },
            {
                "name": "title",
                "type": "string",
                "label": "导航标题",
                "persisted": true,
                "required": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true,
                "normalize": [],
                "validation": [
                    {
                        "type": "max_length",
                        "value": 150,
                        "message": "导航标题不能超过 150 个字符"
                    }
                ]
            },
            {
                "name": "type",
                "type": "string",
                "label": "导航类型",
                "persisted": true,
                "default": "group",
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true,
                "options": {
                    "mode": "static",
                    "value_policy": "closed",
                    "items": [
                        {
                            "value": "group",
                            "label": "导航分组",
                            "description": "组织子菜单，不设置访问地址"
                        },
                        {
                            "value": "schema",
                            "label": "Schema 资源",
                            "description": "打开已发布的 Schema 数据页面"
                        },
                        {
                            "value": "page",
                            "label": "页面",
                            "description": "打开宿主或所属插件已注册的页面"
                        },
                        {
                            "value": "external",
                            "label": "外部链接",
                            "description": "跳转到站外网址"
                        }
                    ]
                }
            },
            {
                "name": "parent_key",
                "type": "string",
                "label": "上级导航",
                "persisted": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": false,
                "normalize": {
                    "trim": true
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 191,
                        "message": "父资源编码不能超过 191 个字符"
                    }
                ],
                "reference": {
                    "resource": "admin.admin_resources",
                    "value_field": "resource_key",
                    "label_field": "title",
                    "parent_field": "parent_key"
                },
                "options": {
                    "mode": "reference",
                    "reference": {
                        "parent_field": "parent_key",
                        "load_mode": "all",
                        "limit": 200,
                        "filters": [
                            {
                                "field": "is_menu",
                                "value": true
                            },
                            {
                                "field": "resource_key",
                                "operator": "<>",
                                "from": "form.resource_key"
                            }
                        ]
                    }
                }
            },
            {
                "name": "path",
                "type": "string",
                "label": "访问地址",
                "persisted": true,
                "required": false,
                "formable": true,
                "listable": true,
                "searchable": false,
                "sortable": false,
                "normalize": {
                    "trim": true
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 255,
                        "message": "前端路径不能超过 255 个字符"
                    }
                ]
            },
            {
                "name": "target_resource_key",
                "type": "string",
                "label": "目标 Schema 资源编码",
                "persisted": false,
                "formable": true,
                "listable": true,
                "searchable": true,
                "normalize": {
                    "trim": true,
                    "case": "lower"
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 191,
                        "message": "目标资源编码不能超过 191 个字符"
                    }
                ]
            },
            {
                "name": "icon",
                "type": "string",
                "label": "菜单图标",
                "persisted": true,
                "formable": true,
                "listable": true,
                "normalize": {
                    "trim": true
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 100,
                        "message": "菜单图标编码不能超过 100 个字符"
                    }
                ]
            },
            {
                "name": "external_url",
                "type": "string",
                "label": "外部链接",
                "persisted": false,
                "formable": true,
                "listable": false,
                "normalize": {
                    "trim": true
                },
                "validation": [
                    {
                        "type": "max_length",
                        "value": 2048,
                        "message": "外部链接不能超过 2048 个字符"
                    }
                ]
            },
            {
                "name": "meta_json",
                "type": "json",
                "label": "菜单元数据",
                "persisted": true,
                "readonly": true,
                "formable": false,
                "listable": false
            },
            {
                "name": "is_menu",
                "type": "boolean",
                "label": "菜单显示",
                "persisted": true,
                "default": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true
            },
            {
                "name": "status",
                "type": "boolean",
                "label": "资源状态",
                "persisted": true,
                "default": true,
                "formable": true,
                "listable": true,
                "searchable": true,
                "sortable": true
            },
            {
                "name": "sort",
                "type": "integer",
                "label": "排序",
                "persisted": true,
                "default": 0,
                "formable": true,
                "listable": true,
                "sortable": true,
                "validation": [
                    {
                        "type": "min",
                        "value": 0,
                        "message": "排序值不能小于 0"
                    }
                ]
            },
            {
                "name": "is_core",
                "type": "boolean",
                "label": "核心资源",
                "persisted": false,
                "readonly": true,
                "formable": false,
                "listable": true
            },
            {
                "name": "owner_type",
                "type": "string",
                "label": "资源来源",
                "persisted": false,
                "readonly": true,
                "formable": false,
                "listable": true,
                "options": {
                    "mode": "static",
                    "value_policy": "closed",
                    "items": [
                        {
                            "value": "core",
                            "label": "核心代码"
                        },
                        {
                            "value": "addon",
                            "label": "插件代码"
                        },
                        {
                            "value": "custom",
                            "label": "后台新增"
                        },
                        {
                            "value": "unknown",
                            "label": "来源未记录"
                        }
                    ]
                }
            },
            {
                "name": "owner_code",
                "type": "string",
                "label": "所属来源",
                "persisted": false,
                "readonly": true,
                "formable": false,
                "listable": true
            },
            {
                "name": "entry_permission",
                "type": "string",
                "label": "入口业务权限",
                "persisted": true,
                "formable": true,
                "listable": true,
                "description": "填写已声明的资源编码.操作编码，不会创建或授予权限"
            },
            {
                "name": "visibility",
                "type": "string",
                "label": "入口可见性",
                "persisted": true,
                "formable": true,
                "default": "permission",
                "options": {
                    "mode": "static",
                    "value_policy": "closed",
                    "items": [
                        {
                            "value": "permission",
                            "label": "按入口权限显示"
                        },
                        {
                            "value": "authenticated",
                            "label": "所有已登录管理员可见"
                        }
                    ]
                }
            }
        ]
    }
}
