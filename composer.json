{
    "name": "ptadmin/core",
    "description": "PTAdmin core package with Admin, Addon, Schema and Core runtime.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Zane",
            "email": "873934580@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2 <9.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "composer/semver": "^3.4",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.68"
    },
    "require-dev": {
        "larastan/larastan": "~3.12.3",
        "orchestra/testbench": "^10.11",
        "phpstan/phpstan": "2.2.14",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "files": [
            "src/Core/Config/helpers.php"
        ],
        "psr-4": {
            "PTAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PTAdmin\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PTAdmin\\Core\\Providers\\PTAdminServiceProvider"
            ]
        }
    },
    "scripts": {
        "phpstan": "@php -d sys_temp_dir=/tmp vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
