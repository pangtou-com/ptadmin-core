{
    "group_code": "system",
    "config_key": "mail",
    "title": "邮件配置",
    "description": "SMTP 服务器和发件人信息。",
    "icon": "notification",
    "schema": {
        "name": "mail",
        "title": "邮件配置",
        "fields": [
            {"name": "host", "type": "string", "label": "SMTP 主机", "default": "127.0.0.1"},
            {"name": "port", "type": "integer", "label": "SMTP 端口", "default": 2525},
            {
                "name": "encryption",
                "type": "string",
                "label": "加密方式",
                "default": "",
                "options": {
                    "mode": "static",
                    "value_policy": "closed",
                    "items": [
                        {"value": "", "label": "自动（服务器支持时使用 STARTTLS）"},
                        {"value": "tls", "label": "要求 STARTTLS"},
                        {"value": "ssl", "label": "SSL（直接建立加密连接）"}
                    ]
                }
            },
            {"name": "username", "type": "string", "label": "SMTP 用户名", "default": ""},
            {"name": "password", "type": "string", "label": "SMTP 密码", "default": "", "extensions": {"secret": {"readable": true}}},
            {"name": "from_address", "type": "string", "label": "发件地址", "required": true, "default": "hello@example.com"},
            {"name": "from_name", "type": "string", "label": "发件人名称", "default": "PTAdmin"}
        ]
    }
}
